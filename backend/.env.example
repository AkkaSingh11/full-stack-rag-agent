# GEMINI_API_KEY=

# LangSmith Configuration (Optional - for tracing and monitoring)
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=fullstack-rag-agent

# Tavily API Key (Optional - for web search fallback when RAG is insufficient)
# TAVILY_API_KEY=

# Hybrid RAG Configuration (Optional - Part 1 implementation)
# RAG_STRATEGY=semantic  # Options: semantic | keyword | hybrid
# HYBRID_ALPHA=0.5       # Range: 0.0-1.0 (0=pure keyword, 0.5=balanced, 1.0=pure semantic)
# RAG_TOP_K=3            # Number of documents to retrieve from knowledge base